{
  "name": "@kevlns/xlmerge",
  "version": "2.0.3",
  "description": "在浏览器中审阅 Git 冲突工作簿的三方差异，校验后写回并提交合并结果。",
  "bin": {
    "xlmerge": "bin/xlmerge.js"
  },
  "files": [
    "bin/",
    "python/xlsx_merge_engine/",
    "python/xlsx_resolver/",
    "v-cli.plugin.json",
    "AGENTS.md",
    "docs/"
  ],
  "vCli": {
    "manifest": "v-cli.plugin.json"
  },
  "scripts": {
    "test": "node bin/xlmerge.js --selfcheck",
    "test:python": "python -m unittest discover -s python/tests -v",
    "check:manifest": "python -m unittest discover -s python/tests -p test_v_cli_plugin_manifest.py -v",
    "docs:style": "node scripts/check-documentation.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevlns/xlmerge.git"
  },
  "homepage": "https://github.com/kevlns/xlmerge#readme",
  "bugs": {
    "url": "https://github.com/kevlns/xlmerge/issues"
  },
  "author": "Vant",
  "engines": {
    "node": ">=16"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "xlsx",
    "xlsm",
    "git",
    "merge-conflict",
    "excel"
  ]
}
